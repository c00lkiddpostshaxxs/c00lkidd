    local isDisplaying = false

    function showNotification(message)
        if isDisplaying then return end
        isDisplaying = true

        NotificationText.Text = message
        NotificationFrame.Position = hiddenPosition
        NotificationFrame.Visible = true

        TweenService:Create(NotificationFrame, tweenInInfo, {Position = visiblePosition}):Play()

        task.wait(tweenDuration + displayDuration)

        TweenService:Create(NotificationFrame, tweenOutInfo, {Position = hiddenPosition}):Play()

        task.wait(tweenDuration)

        NotificationFrame.Visible = false
        isDisplaying = false
    end

